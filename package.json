{
  "name": "trial-conversion-dashboard",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "sync": "tsx src/sync-cli.ts",
    "digest": "tsx src/digest-cli.ts",
    "probe:solidgate": "tsx scripts/probe-solidgate.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "express": "^5.3.0",
    "node-cron": "^4.6.0",
    "stripe": "^18.5.0"
  }
}
