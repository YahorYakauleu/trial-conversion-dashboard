# Stripe: restricted read-only ключи, через запятую: <аккаунт>=<ключ>
STRIPE_KEYS=org=rk_live_xxx,corp=rk_live_yyy
# Solidgate: <канал>=<public>:<secret>, через запятую
SOLIDGATE_KEYS=sg=api_pk_xxx:api_sk_xxx,sgH2H=api_pk_yyy:api_sk_yyy

RETRY_WINDOW_DAYS=30
# По какому времени резать сутки (IANA) — как в кабинете провайдера:
# Stripe — часовой пояс аккаунта (по умолчанию America/New_York), Solidgate Hub — UTC (по умолчанию)
TIMEZONE=America/New_York
SOLIDGATE_TIMEZONE=UTC
# С какой даты оформления триалов строить отчёт (местная дата провайдера)
HISTORY_FROM=2026-09-01
SYNC_CRON=0 5 * * *

BASIC_AUTH_USER=billing
BASIC_AUTH_PASSWORD=change-me

DATA_DIR=./data
PORT=3000
