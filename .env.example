# Stripe: restricted read-only ключи, через запятую: <аккаунт>=<ключ>
STRIPE_KEYS=org=rk_live_xxx,corp=rk_live_yyy
# Solidgate: <канал>=<public>:<secret>, через запятую
SOLIDGATE_KEYS=sg=api_pk_xxx:api_sk_xxx,sgH2H=api_pk_yyy:api_sk_yyy

# Stripe-аккаунт Toggle eSim (необязательно): restricted key только на чтение — Charges, Payment Intents, Customers,
# Refunds, Events. Без него продукта eSIM в дашборде нет
ESIM_STRIPE_KEY=

RETRY_WINDOW_DAYS=30
# Порог Visa VAMP для мерчанта (Excessive) за месяц: ratio — доля, count — штук; по умолчанию 1,5% и 1 500
VAMP_RATIO_THRESHOLD=0.015
VAMP_COUNT_THRESHOLD=1500
# По какому времени резать сутки (IANA) — как в кабинете провайдера:
# Stripe — часовой пояс аккаунта (по умолчанию America/New_York), Solidgate Hub — UTC (по умолчанию)
TIMEZONE=America/New_York
SOLIDGATE_TIMEZONE=UTC
# С какой даты оформления триалов строить отчёт (местная дата провайдера)
HISTORY_FROM=2026-09-01
# Автосинк (cron, UTC): по умолчанию каждые 4 часа
SYNC_CRON=0 */4 * * *

# Вход: админ — всё, включая синк; гость (необязательно) — только просмотр.
# Старые BASIC_AUTH_USER / BASIC_AUTH_PASSWORD тоже работают — как вход админа.
ADMIN_USER=billing-admin
ADMIN_PASSWORD=change-me
GUEST_USER=billing-guest
GUEST_PASSWORD=change-me-too

DATA_DIR=./data
PORT=3000
